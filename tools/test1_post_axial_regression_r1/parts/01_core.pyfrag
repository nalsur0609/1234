def git_show(ref: str, path: str) -> bytes:
    key = (ref, path)
    if key == (DATA_REF, DATA_CATALOG_PATH):
        return b"".join((ROOT / p).read_bytes() for p in CARRIER_CATALOG_CHUNKS)
    local_path = CARRIER_SOURCE_MAP.get(key)
    if local_path is None:
        raise RuntimeError(f"carrier payload does not materialize {ref}:{path}")
    return (ROOT / local_path).read_bytes()


def carrier_expected_blob(ref: str, path: str) -> str:
    if (ref, path) == (DATA_REF, DATA_CATALOG_PATH):
        return CARRIER_CATALOG_SUBSET_BLOB
    return EXPECTED_BLOBS[(ref, path)]


def git_blob_sha1(payload: bytes) -> str:
    return hashlib.sha1(f"blob {len(payload)}\0".encode("ascii") + payload).hexdigest()


def checked_bytes(ref: str, path: str) -> bytes:
    payload = git_show(ref, path)
    expected = carrier_expected_blob(ref, path)
    actual = git_blob_sha1(payload)
    if actual != expected:
        raise AssertionError(f"carrier blob drift {ref}:{path}: {actual} != {expected}")
    return payload


def load_jsonl(ref: str, path: str) -> list[dict[str, Any]]:
    return [
        json.loads(line)
        for line in checked_bytes(ref, path).decode("utf-8").splitlines()
        if line.strip()
    ]


def load_module_from_bytes(name: str, payload: bytes) -> ModuleType:
    with tempfile.TemporaryDirectory(prefix=f"{name}_") as td:
        path = Path(td) / f"{name}.py"
        path.write_bytes(payload)
        spec = importlib.util.spec_from_file_location(name, path)
        if spec is None or spec.loader is None:
            raise RuntimeError(f"cannot load module {name}")
        module = importlib.util.module_from_spec(spec)
        sys.modules[name] = module
        spec.loader.exec_module(module)
        return module


def bind_repaired_rules(module: ModuleType) -> None:
    module.ROOT = ROOT
    module.RULES_REF = RULES_REF
    if hasattr(module, "RULES_SNAPSHOT_ID"):
        module.RULES_SNAPSHOT_ID = RULES_SNAPSHOT_ID
    if hasattr(module, "git_show"):
        module.git_show = git_show
    if hasattr(module, "_git_show"):
        module._git_show = git_show
    old = getattr(module, "EXPECTED_BLOBS", None)
    if isinstance(old, dict):
        old.pop((OLD_RULES_REF, RULES_PATH), None)
        old[(DATA_REF, DATA_CATALOG_PATH)] = CARRIER_CATALOG_SUBSET_BLOB
        old[(DATA_REF, DATA_SUFFICIENCY_PATH)] = EXPECTED_BLOBS[(DATA_REF, DATA_SUFFICIENCY_PATH)]
        old[(RULES_REF, RULES_PATH)] = EXPECTED_BLOBS[(RULES_REF, RULES_PATH)]
        old[(ENGINE_REF, ENGINE_PATH)] = EXPECTED_BLOBS[(ENGINE_REF, ENGINE_PATH)]
        old[(BASE_REF, SCHEMA_PATH)] = EXPECTED_BLOBS[(BASE_REF, SCHEMA_PATH)]


def positive_payload(state: Any, profile: str, suffix: str) -> dict[str, Any]:
    anchor = state.eligible_by_profile[profile][0]
    contract = state.contracts[profile]
    parameters: dict[str, Any] = {}
    for parameter in contract["parameters"]:
        if parameter["role"] != "MANDATORY":
            continue
        fact = anchor["facts"][parameter["key"]]
        if fact["state"] != "KNOWN":
            raise AssertionError(f"{profile}:{parameter['key']} not KNOWN")
        parameters[parameter["key"]] = {
            "value": copy.deepcopy(fact.get("value")),
            "unit": fact.get("unit"),
        }
    return {
        "request_id": f"post-axial-{suffix}",
        "position_id": suffix,
        "raw_request_text": f"post-axial regression positive {profile}",
        "profile": profile,
        "parameters": parameters,
    }


def numeric_contradiction_value(semantic: str, values: list[float | int]) -> float | int | None:
    if not values:
        return None
    if semantic == "NUMERIC_EQUAL":
        return max(values) + 1
    if semantic == "CANDIDATE_LTE_REQUEST":
        return min(values) - 1
    if semantic == "CANDIDATE_GTE_REQUEST":
        return max(values) + 1
    return None


def build_contradiction_payload(state: Any) -> tuple[str, dict[str, Any], str]:
    for profile in state.profile_ids:
        base = positive_payload(state, profile, "contradiction")
        contract = state.contracts[profile]
        anchor = state.eligible_by_profile[profile][0]
        for parameter in contract["parameters"]:
            if parameter["role"] != "MANDATORY":
                continue
            key = parameter["key"]
            values = [
                p["facts"][key]["value"]
                for p in state.by_group[profile]
                if p["facts"].get(key, {}).get("state") == "KNOWN"
                and isinstance(p["facts"][key].get("value"), (int, float))
                and not isinstance(p["facts"][key].get("value"), bool)
            ]
            replacement = numeric_contradiction_value(parameter["comparison_semantics"], values)
            if replacement is not None:
                trial = copy.deepcopy(base)
                trial["parameters"][key] = {
                    "value": replacement,
                    "unit": anchor["facts"][key].get("unit"),
                }
                status, body = state.select(trial)
                if int(status) == 200 and body["result"]["result_class"] == "TEST1_NOT_SELECTED":
                    return profile, trial, key

        for parameter in contract["parameters"]:
            if parameter["role"] != "MANDATORY" or parameter["comparison_semantics"] != "EQUALS":
                continue
            key = parameter["key"]
            base_value = anchor["facts"][key].get("value")
            alternate = next((
                p for p in state.by_group[profile]
                if p["facts"].get(key, {}).get("state") == "KNOWN"
                and p["facts"][key].get("value") != base_value
            ), None)
            if alternate is None:
                continue
            trial = copy.deepcopy(base)
            trial["parameters"][key] = {
                "value": copy.deepcopy(alternate["facts"][key].get("value")),
                "unit": alternate["facts"][key].get("unit"),
            }
            status, body = state.select(trial)
            if int(status) == 200 and body["result"]["result_class"] == "TEST1_NOT_SELECTED":
                return profile, trial, key
    raise AssertionError("cannot build contradiction fixture")


def http_json(method: str, url: str, payload: Mapping[str, Any] | None = None) -> tuple[int, dict[str, Any]]:
    data = None
    headers: dict[str, str] = {}
    if payload is not None:
        data = json.dumps(payload, ensure_ascii=False, sort_keys=True).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            return int(response.status), json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raw = exc.read()
        return int(exc.code), json.loads(raw.decode("utf-8")) if raw else {}


def start_web() -> tuple[Any, Any, str, threading.Thread]:
    web = load_module_from_bytes("test1_post_axial_web_r1", checked_bytes(WEB_REF, WEB_APP_PATH))
    bind_repaired_rules(web)
    state = web.RuntimeState()
    server = web.Test1WebServer(("127.0.0.1", 0), state)
    thread = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": 0.05}, daemon=True)
    thread.start()
    host, port = server.server_address[:2]
    base_url = f"http://{host}:{port}"
    status, body = http_json("GET", base_url + "/health")
    if status != 200 or body.get("status") != "ok":
        server.shutdown()
        server.server_close()
        raise AssertionError(f"WEB health failed: {status} {body}")
    return web, server, base_url, thread


def stop_web(server: Any, thread: threading.Thread) -> None:
    server.shutdown()
    server.server_close()
    thread.join(timeout=5)
    if thread.is_alive():
        raise RuntimeError("WEB server thread did not stop")


